;; ============================================================
;; ИСПРАВЛЕНО (Р1.1, хот-фикс): сигнатура приведена в соответствие
;; с вызовом из диспетчера:
;;   (vl-catch-all-apply 'cutsheet-main (list layers))
;; Сам модуль раскроя листа НЕ реализуется этим коммитом.
;; ============================================================
(defun cutsheet-main (layers / )
  (princ "\nCUTSHEET: модуль в разработке.")
  (princ "\nВыбранные слои: ")
  (if layers
    (foreach l layers (princ (strcat l " ")))
    (princ "все")
  )
  (princ)
  ;; Возвращаем T, чтобы диспетчер не считал это ошибкой
  T
)