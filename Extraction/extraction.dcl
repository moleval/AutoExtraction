// ============================================================
// extraction.dcl — Диалог AutoExtraction
// ============================================================

// ГЕОМЕТРИЯ ОКНА (ручной подбор от ширины поля «Поиск»)
//
//   W = 47.2  ширина рамки панели. Поле «Поиск» своей ширины не имеет —
//             оно заполняет рамку, поэтому ширина поля = W - 2.2 = 45.0
//             (2.2 съедает рамка). Это же число стоит у ВСЕХ восьми рамок.
//   G = 0.3   зазор между левой и правой колонками (4 места), зафиксирован.
//
//   ширина окна      = W + G + W = 94.7
//   рамка «Раскрой»  = 72
//
// Ширину окна задаёт САМЫЙ ШИРОКИЙ ряд. Поэтому шапка не должна быть
// шире ряда панелей, иначе излишек уходит в центральный зазор и по
// центру окна появляется «дыра»:
//
//   шапка = «Раскрой» + зазор (мин. 1) + рамка «Настройки/?» (21.6)
//         = 72 + 1 + 21.6 = 94.6  <=  94.7   -- условие выполнено
//
// ДВЕ ЖЁСТКИЕ СВЯЗИ. Любые два числа задают третье, все три независимо
// назначить нельзя:
//   (1) окно = 2 * поле + 4.7      (4.7 = два отступа рамок 2.2 + зазор 0.3)
//   (2) окно >= «Раскрой» + 22.6   (22.6 = зазор 1 + рамка «Настройки/?»)
//
// Порядок пересчёта при смене любого из двух чисел:
//   задали ширину поля «Поиск» P -> W = P + 2.2 -> окно = 2W + G,
//                                   «Раскрой» <= окно - 22.6
//   задали «Раскрой» R           -> W >= (R + 1 + 21.6 - G) / 2
//
// Менять W нужно сразу во всех восьми рамках, иначе разъедется сетка.

extraction_dialog : dialog {

  label = "AutoExtraction";

  initial_focus = "lst_layers";


  // ==========================================================
  // ЗАГОЛОВОК: РАСКРОЙ + НАСТРОЙКИ
  // ==========================================================

  : row {

    // Блок раскроя уже ширины окна: справа должно остаться место
    // на «Настройки» и «?»
    : boxed_column {

      label = "Раскрой";

      width = 72;
      fixed_width = true;

      : row {
        : button {
          key = "btn_cutline";
          label = "Раскрой хлыста";
        }

        : button {
          key = "btn_cutsheet";
          label = "Раскрой листа";
        }
      }

      // Нижний отступ как у панели «Блоки» под кнопкой «Копия»
      : spacer {
        height = 0.1;
      }
    }

    : spacer {
      // Гибкий отступ держит «Настройки» и «?» у правого края
      width = 1;
      fixed_width = false;
    }

    // Рамка с пустым заголовком: её заголовок занимает столько же
    // по высоте, сколько заголовок «Раскрой», поэтому ряды кнопок
    // встают на один уровень без подбора отступа
    : boxed_column {
      label = "";
      fixed_width = true;
      children_fixed_width = true;

      : row {
        fixed_width = true;
        children_fixed_width = true;

        : button {
          key = "btn_settings";
          label = "Настройки";
          fixed_width = true;
          width = 12;
        }

        : button {
          key = "btn_help";
          label = "?";
          fixed_width = true;
          width = 4;
        }
      }

      // Нижний отступ как у панели «Блоки» под кнопкой «Копия»
      : spacer {
        height = 0.1;
      }
    }
  }


  : spacer {
    height = 0.1;
  }


  // ==========================================================
  // ФИЛЬТРЫ
  // ==========================================================

  : row {

    // Колонка по ширине панели «Слои»
    // Рамка без заголовка: тот же отступ, что у панели ниже, поэтому
    // чекбоксы встают ровно над полем поиска слоёв
    : boxed_column {
      label = "";
      width = 47.2;
      fixed_width = true;
      children_alignment = left;
      children_fixed_width = true;

      // Фильтры слоёв: вплотную друг к другу
      : row {
        fixed_width = true;
        children_fixed_width = true;
        alignment = left;

        : toggle {
          key = "chk_filter_my";
          label = "Мои";
        }

        : toggle {
          key = "chk_filter_facades";
          label = "Фасады";
        }

        : toggle {
          key = "chk_filter_vitrazh";
          label = "Витражи";
        }

        : toggle {
          key = "chk_filter_windows";
          label = "Окна";
        }
      }

      // Нижний отступ как у панели «Блоки» под кнопкой «Копия»
      : spacer {
        height = 0.1;
      }
    }


    // Тот же отступ между колонками, что у панелей ниже
    : spacer {
      // Зазор ЗАФИКСИРОВАН: иначе он растягивается и собирает
      // весь излишек ширины окна — это и была «дыра» по центру
      width = 0.3;
      fixed_width = true;
    }


    // Колонка по ширине панели «Блоки» (рамка без заголовка — см. выше)
    : boxed_column {
      label = "";
      width = 47.2;
      fixed_width = true;
      children_alignment = left;
      children_fixed_width = true;

      : toggle {
        key = "chk_filter_anonymous";
        label = "Анонимные блоки";
        alignment = left;
        fixed_width = true;
      }

      // Нижний отступ как у панели «Блоки» под кнопкой «Копия»
      : spacer {
        height = 0.1;
      }
    }
  }


  : spacer {
    height = 0.1;
  }


  // ==========================================================
  // ВЕРХНИЙ РЯД: СЛОИ | БЛОКИ
  // ==========================================================

  : row {

    // --------------------------------------------------------
    // СЛОИ
    // --------------------------------------------------------

    : boxed_column {

      label = "Слои";

      width = 47.2;
      fixed_width = true;

      // Ширины НЕ задаются: каждый элемент заполняет ширину панели,
      // поэтому их левые и правые края совпадают по построению
      // (подсказка в поле видна, пока оно пусто)
      : edit_box {
        key = "edt_layer_search";
      }

      : list_box {

        key = "lst_layers";

        height = 13;

        multiple_select = true;
      }

      : text {
        key = "txt_layers_hint";
        label = "Если слои не выбраны — поиск по всем слоям";
      }

      // Компенсация высоты: в панели «Блоки» на этом месте поле ввода
      // («Введите новое имя»), оно выше текста статуса на свою рамку.
      // Без этого отступа кнопки слоёв стоят чуть выше кнопок блоков.
      : spacer {
        height = 0.1;
      }

      // ------------------------------------------------------
      // КНОПКИ ВЫБРАТЬ ВСЕ + СНЯТЬ ВЫДЕЛЕНИЕ — ниже строки
      // состояния, на уровне кнопок блоков (Копия/Вставить/Имя).
      // Ряд заполняет ширину панели, кнопки делят её поровну:
      // правый край ряда совпадает с правым краем поля поиска.
      // ------------------------------------------------------

      : row {
        : button {
          key = "btn_select_all";
          label = "Выбрать все";
        }

        : button {
          key = "btn_clear_all";
          label = "Снять выделение";
        }
      }
    }


    // --------------------------------------------------------
    // ПРОМЕЖУТОК
    // --------------------------------------------------------

    : spacer {
      // Зазор ЗАФИКСИРОВАН: иначе он растягивается и собирает
      // весь излишек ширины окна — это и была «дыра» по центру
      width = 0.3;
      fixed_width = true;
    }


    // --------------------------------------------------------
    // БЛОКИ
    // --------------------------------------------------------

    : boxed_column {

      label = "Блоки";

      width = 47.2;
      fixed_width = true;

      // Ширины НЕ задаются: каждый элемент заполняет ширину панели,
      // поэтому их левые и правые края совпадают по построению
      // (подсказка в поле видна, пока оно пусто)
      : edit_box {
        key = "edt_block_search";
      }

      : list_box {
        key = "lst_blocks";
        height = 13;
        multiple_select = false;
      }

      : edit_box {
        key = "edt_block_rename";
      }

      // ------------------------------------------------------
      // КНОПКИ КОПИЯ + ВСТАВИТЬ + ИМЯ
      // Ряд заполняет ширину панели, кнопки делят её поровну:
      // правый край ряда совпадает с правым краем поля поиска.
      // ------------------------------------------------------

      : row {
        : button {
          key = "btn_block_copy";
          label = "Копия";
        }

        : button {
          key = "btn_block_insert";
          label = "Вставить";
        }

        : button {
          key = "btn_block_rename";
          label = "Имя";
        }
      }
    }
  }


  : spacer {
    height = 0.1;
  }


  // ==========================================================
  // СРЕДНИЙ РЯД: ЗАДАЧИ | СЛОИ ПОДСИСТЕМЫ
  // ==========================================================

  : row {

    : boxed_radio_column {

      label = "Задачи";

      width = 47.2;
      fixed_width = true;

      : radio_button {
        key = "rb_task_fasonka";
        label = "Фасонка";
      }

      : radio_button {
        key = "rb_task_subsystem";
        label = "Подсистема";
      }

      : radio_button {
        key = "rb_task_cladding";
        label = "Облицовка";
      }

      : radio_button {
        key = "rb_task_vitrazh";
        label = "Витраж";
      }

      : radio_button {
        key = "rb_task_zapolnenie";
        label = "Заполнение";
      }

      // Нижний отступ как у панели «Блоки» под кнопкой «Копия»
      : spacer {
        height = 0.1;
      }
    }


    : spacer {
      // Зазор ЗАФИКСИРОВАН: иначе он растягивается и собирает
      // весь излишек ширины окна — это и была «дыра» по центру
      width = 0.3;
      fixed_width = true;
    }


    : boxed_column {

      label = "Слои подсистемы";

      key = "box_subsystem_layers";

      width = 47.2;
      fixed_width = true;

      : toggle {
        key = "chk_subsystem_1";
        label = "Подсистема";
      }

      : toggle {
        key = "chk_subsystem_2";
        label = "Подсистема алюминиевая";
      }

      : toggle {
        key = "chk_subsystem_3";
        label = "Подсистема оцинкованная";
      }

      // Нижний отступ как у панели «Блоки» под кнопкой «Копия»
      : spacer {
        height = 0.1;
      }
    }
  }


  : spacer {
    height = 0.1;
  }


  // ==========================================================
  // НИЖНИЙ РЯД: РЕЖИМ ОТЧЕТА | ВЫВОД
  // ==========================================================

  : row {

    : boxed_radio_column {

      label = "Режим отчета";

      width = 47.2;
      fixed_width = true;

      : radio_button {
        key = "rb_detail";
        label = "Подробный";
      }

      : radio_button {
        key = "rb_summary";
        label = "Краткий";
      }

      // Нижний отступ как у панели «Блоки» под кнопкой «Копия»
      : spacer {
        height = 0.1;
      }
    }


    : spacer {
      // Зазор ЗАФИКСИРОВАН: иначе он растягивается и собирает
      // весь излишек ширины окна — это и была «дыра» по центру
      width = 0.3;
      fixed_width = true;
    }


    : boxed_column {

      label = "Вывод";

      width = 47.2;
      fixed_width = true;

      : toggle {
        key = "chk_xls";
        label = ".xls";
      }

      : toggle {
        key = "chk_txt";
        label = ".txt";
      }

      : toggle {
        key = "chk_acad";
        label = "AutoCAD";
      }

      // Нижний отступ как у панели «Блоки» под кнопкой «Копия»
      : spacer {
        height = 0.1;
      }
    }
  }


  : spacer {
    height = 0.1;
  }


  // ==========================================================
  // КНОПКИ
  // ==========================================================

  : row {

    alignment = centered;

    : button {
      key = "btn_save";
      label = "Сохранить";
      is_default = true;
    }

    : button {
      key = "btn_saveas";
      label = "Сохранить как...";
    }

    : button {
      key = "btn_close";
      label = "Закрыть";
      is_cancel = true;
    }
  }
}
