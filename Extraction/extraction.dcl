// ============================================================
// extraction.dcl — Диалог AutoExtraction
// ============================================================

// ГЕОМЕТРИЯ ОКНА (ручной подбор от ширины поля «Поиск»)
//
//   W = 47.2  ширина рамки панели. Поле «Поиск» своей ширины не имеет —
//             оно заполняет рамку, поэтому ширина поля = W - 2.2 = 45.0
//             (2.2 съедает рамка). Это же число стоит у ВСЕХ восьми рамок.
//   G = 0.3   зазор между левой и правой колонками (4 места), зафиксирован.
//
//   ширина окна      = W + G + W + 2*D = 98.7
//   рамка «Раскрой»  = 73
//
//   D = 2.0   промежуток, который DCL САМ вставляет между соседними
//             тайлами в ряду. Его нельзя убрать, и именно он даёт
//             видимый зазор: между колонками это D + G + D = 4.3.
//
// Ширину окна задаёт САМЫЙ ШИРОКИЙ ряд. Поэтому шапка не должна быть
// шире ряда панелей, иначе излишек уходит в центральный зазор и по
// центру окна появляется «дыра»:
//
//   шапка = «Раскрой» + D + G + D + рамка «Настройки/?» (21.0)
//         = 73 + 2.0 + 0.3 + 2.0 + 21.0 = 98.3  = ширина окна
//
// ДВЕ ЖЁСТКИЕ СВЯЗИ. Любые два числа задают третье, все три независимо
// назначить нельзя:
//   (1) окно = 2 * поле + 8.7      (8.7 = 2*2.2 рамки + 0.3 зазор + 2*2.0 DCL)
//   (2) «Раскрой» = окно - 25.3    (25.3 = 21.0 «Настройки/?» + 0.3 + 2*2.0)
//
// Числа 2.2 (отступ рамки), 2.0 (промежуток DCL) и 21.0 (рамка кнопок)
// измерены по скриншоту живого окна, масштаб 12.18 px на символ.
//
// Порядок пересчёта при смене любого из двух чисел:
//   задали ширину поля «Поиск» P -> W = P + 2.2 -> окно = 2W + G,
//                                   «Раскрой» <= окно - 22.6
//   задали «Раскрой» R           -> W >= (R + 1 + 21.6 - G) / 2
//
// Менять W нужно сразу во всех восьми рамках, иначе разъедется сетка.

extraction_dialog : dialog {

  label = "AutoExtraction";

  initial_focus = "lst_layers";


  // Боковые поля окна — такие же, как вертикальные отступы.
  // Всё содержимое завёрнуто в ОДИН ряд с отступами по краям, поэтому
  // поле одинаково по всей высоте окна и задаётся в одном месте.
  // Содержимое ниже намеренно не переотступлено: DCL к отступам в файле
  // безразличен, зато правка читается как две вставки, а не как сдвиг
  // пятисот строк.
  : row {

  : spacer {
    width = 0.6;
    fixed_width = true;
  }

  : column {


  // Отступ от заголовка окна — такой же, как между рамками
  : spacer {
    height = 0.1;
  }


  // ==========================================================
  // ЗАГОЛОВОК: РАСКРОЙ + НАСТРОЙКИ
  // ==========================================================

  : row {

    // Блок раскроя уже ширины окна: справа должно остаться место
    // на «Настройки» и «?»
    : boxed_column {

      label = "Раскрой";

      width = 73;
      fixed_width = true;

      : row {
        : button {
          key = "btn_cutline";
          label = "Раскрой хлыста";
        }

        : button {
          key = "btn_cutsheet";
          label = "Раскрой листа";
        }
      }

      // Нижний отступ как у панели «Блоки» под кнопкой «Копия»
      : spacer {
        height = 0.1;
      }
    }

    : spacer {
      // Зазор как между панелями «Слои» и «Блоки».
      // Видимый зазор = 2.0 (промежуток DCL) + 0.3 + 2.0 (промежуток DCL).
      width = 0.3;
      fixed_width = true;
    }

    // Рамка с пустым заголовком: её заголовок занимает столько же
    // по высоте, сколько заголовок «Раскрой», поэтому ряды кнопок
    // встают на один уровень без подбора отступа
    : boxed_column {
      label = "";
      fixed_width = true;
      children_fixed_width = true;

      : row {
        fixed_width = true;
        children_fixed_width = true;

        : button {
          key = "btn_settings";
          label = "Настройки";
          fixed_width = true;
          width = 12;
        }

        : button {
          key = "btn_help";
          label = "?";
          fixed_width = true;
          width = 4;
        }
      }

      // Нижний отступ как у панели «Блоки» под кнопкой «Копия»
      : spacer {
        height = 0.1;
      }
    }
  }


  : spacer {
    height = 0.1;
  }


  // ==========================================================
  // ФИЛЬТРЫ
  // ==========================================================

  : row {

    // Колонка по ширине панели «Слои»
    // Рамка без заголовка: тот же отступ, что у панели ниже, поэтому
    // чекбоксы встают ровно над полем поиска слоёв
    : boxed_column {
      label = "";
      width = 47.2;
      fixed_width = true;
      children_alignment = left;
      children_fixed_width = true;

      // Фильтры слоёв: вплотную друг к другу
      : row {
        fixed_width = true;
        children_fixed_width = true;
        alignment = left;

        : toggle {
          key = "chk_filter_my";
          label = "Мои";
        }

        : toggle {
          key = "chk_filter_facades";
          label = "Фасады";
        }

        : toggle {
          key = "chk_filter_vitrazh";
          label = "Витражи";
        }

        : toggle {
          key = "chk_filter_windows";
          label = "Окна";
        }
      }

      // Нижний отступ как у панели «Блоки» под кнопкой «Копия»
      : spacer {
        height = 0.1;
      }
    }


    // Тот же отступ между колонками, что у панелей ниже
    : spacer {
      // Зазор ЗАФИКСИРОВАН: иначе он растягивается и собирает
      // весь излишек ширины окна — это и была «дыра» по центру
      width = 0.3;
      fixed_width = true;
    }


    // Колонка по ширине панели «Блоки» (рамка без заголовка — см. выше)
    : boxed_column {
      label = "";
      width = 47.2;
      fixed_width = true;
      children_alignment = left;
      children_fixed_width = true;

      : toggle {
        key = "chk_filter_anonymous";
        label = "Анонимные блоки";
        alignment = left;
        fixed_width = true;
      }

      // Нижний отступ как у панели «Блоки» под кнопкой «Копия»
      : spacer {
        height = 0.1;
      }
    }
  }


  : spacer {
    height = 0.1;
  }


  // ==========================================================
  // ВЕРХНИЙ РЯД: СЛОИ | БЛОКИ
  // ==========================================================

  : row {

    // --------------------------------------------------------
    // СЛОИ
    // --------------------------------------------------------

    : boxed_column {

      label = "Слои";

      width = 47.2;
      fixed_width = true;

      // Ширины НЕ задаются: каждый элемент заполняет ширину панели,
      // поэтому их левые и правые края совпадают по построению
      // (подсказка в поле видна, пока оно пусто)
      : edit_box {
        key = "edt_layer_search";
      }

      : list_box {

        key = "lst_layers";

        height = 13;

        multiple_select = true;
      }

      // Текст статуса центрируется в ряду высотой с поле ввода
      // «Введите новое имя» панели «Блоки». Отступом сюда не попасть:
      // DCL квантует вертикальные отступы шагом около строки, а нужен
      // сдвиг в половину шага. Внутри ряда тайл центрируется по
      // вертикали — ровно так же центрируется текст внутри поля ввода.
      // Высота 2 строки = высота поля ввода, поэтому колонка не
      // меняется по высоте и кнопки остаются на своём уровне.
      : row {
        height = 2;
        fixed_height = true;

        : text {
          key = "txt_layers_hint";
          label = "Если слои не выбраны — поиск по всем слоям";
        }
      }

      // ------------------------------------------------------
      // КНОПКИ ВЫБРАТЬ ВСЕ + СНЯТЬ ВЫДЕЛЕНИЕ — ниже строки
      // состояния, на уровне кнопок блоков (Копия/Вставить/Имя).
      // Ряд заполняет ширину панели, кнопки делят её поровну:
      // правый край ряда совпадает с правым краем поля поиска.
      // ------------------------------------------------------

      : row {
        : button {
          key = "btn_select_all";
          label = "Выбрать все";
        }

        : button {
          key = "btn_clear_all";
          label = "Снять выделение";
        }
      }
    }


    // --------------------------------------------------------
    // ПРОМЕЖУТОК
    // --------------------------------------------------------

    : spacer {
      // Зазор ЗАФИКСИРОВАН: иначе он растягивается и собирает
      // весь излишек ширины окна — это и была «дыра» по центру
      width = 0.3;
      fixed_width = true;
    }


    // --------------------------------------------------------
    // БЛОКИ
    // --------------------------------------------------------

    : boxed_column {

      label = "Блоки";

      width = 47.2;
      fixed_width = true;

      // Ширины НЕ задаются: каждый элемент заполняет ширину панели,
      // поэтому их левые и правые края совпадают по построению
      // (подсказка в поле видна, пока оно пусто)
      : edit_box {
        key = "edt_block_search";
      }

      : list_box {
        key = "lst_blocks";
        height = 13;
        multiple_select = false;
      }

      : edit_box {
        key = "edt_block_rename";
      }

      // ------------------------------------------------------
      // КНОПКИ КОПИЯ + ВСТАВИТЬ + ИМЯ
      // Ряд заполняет ширину панели, кнопки делят её поровну:
      // правый край ряда совпадает с правым краем поля поиска.
      // ------------------------------------------------------

      : row {
        : button {
          key = "btn_block_copy";
          label = "Копия";
        }

        : button {
          key = "btn_block_insert";
          label = "Вставить";
        }

        : button {
          key = "btn_block_rename";
          label = "Имя";
        }
      }
    }
  }


  : spacer {
    height = 0.1;
  }


  // ==========================================================
  // СРЕДНИЙ РЯД: ЗАДАЧИ | СЛОИ ПОДСИСТЕМЫ
  // ==========================================================

  : row {

    : boxed_radio_column {

      label = "Задачи";

      width = 47.2;
      fixed_width = true;

      : radio_button {
        key = "rb_task_fasonka";
        label = "Фасонка";
      }

      : radio_button {
        key = "rb_task_subsystem";
        label = "Подсистема";
      }

      : radio_button {
        key = "rb_task_cladding";
        label = "Облицовка";
      }

      : radio_button {
        key = "rb_task_vitrazh";
        label = "Витраж";
      }

      : radio_button {
        key = "rb_task_zapolnenie";
        label = "Заполнение";
      }

      // Нижний отступ как у панели «Блоки» под кнопкой «Копия»
      : spacer {
        height = 0.1;
      }
    }


    : spacer {
      // Зазор ЗАФИКСИРОВАН: иначе он растягивается и собирает
      // весь излишек ширины окна — это и была «дыра» по центру
      width = 0.3;
      fixed_width = true;
    }


    : boxed_column {

      label = "Слои подсистемы";

      key = "box_subsystem_layers";

      width = 47.2;
      fixed_width = true;

      : toggle {
        key = "chk_subsystem_1";
        label = "Подсистема";
      }

      : toggle {
        key = "chk_subsystem_2";
        label = "Подсистема алюминиевая";
      }

      : toggle {
        key = "chk_subsystem_3";
        label = "Подсистема оцинкованная";
      }

      // Нижний отступ как у панели «Блоки» под кнопкой «Копия»
      : spacer {
        height = 0.1;
      }
    }
  }


  : spacer {
    height = 0.1;
  }


  // ==========================================================
  // НИЖНИЙ РЯД: РЕЖИМ ОТЧЕТА | ВЫВОД
  // ==========================================================

  : row {

    : boxed_radio_column {

      label = "Режим отчета";

      width = 47.2;
      fixed_width = true;

      // Остаток высоты делят поровну отступы сверху и снизу — кнопки
      // оказываются по центру рамки. В соседней рамке «Вывод» три
      // флажка против двух кнопок здесь, поэтому остаток и возникает.
      : spacer {
        height = 0.1;
      }

      : radio_button {
        key = "rb_detail";
        label = "Подробный";
        fixed_height = true;
      }

      : radio_button {
        key = "rb_summary";
        label = "Краткий";
        fixed_height = true;
      }

      // Нижний отступ как у панели «Блоки» под кнопкой «Копия»
      : spacer {
        height = 0.1;
      }
    }


    : spacer {
      // Зазор ЗАФИКСИРОВАН: иначе он растягивается и собирает
      // весь излишек ширины окна — это и была «дыра» по центру
      width = 0.3;
      fixed_width = true;
    }


    : boxed_column {

      label = "Вывод";

      width = 47.2;
      fixed_width = true;

      : toggle {
        key = "chk_xls";
        label = ".xls";
      }

      : toggle {
        key = "chk_txt";
        label = ".txt";
      }

      : toggle {
        key = "chk_acad";
        label = "AutoCAD";
      }

      // Нижний отступ как у панели «Блоки» под кнопкой «Копия»
      : spacer {
        height = 0.1;
      }
    }
  }


  : spacer {
    height = 0.1;
  }


  // ==========================================================
  // КНОПКИ
  // ==========================================================

  : row {

    alignment = centered;

    // Высота кнопок — как у кнопок внутри панелей («Копия» и другие).
    // Без этого ряд последний в колонке диалога, забирает остаток
    // высоты и растягивает кнопки.
    fixed_height = true;
    children_fixed_height = true;

    : button {
      key = "btn_save";
      label = "Сохранить";
      is_default = true;
    }

    : button {
      key = "btn_saveas";
      label = "Сохранить как...";
    }

    : button {
      key = "btn_close";
      label = "Закрыть";
      is_cancel = true;
    }
  }


  // Отступ под кнопками — такой же, как над рамкой «Раскрой»
  : spacer {
    height = 0.1;
  }

  }

  : spacer {
    width = 0.6;
    fixed_width = true;
  }

  }
}
