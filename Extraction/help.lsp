(defun ae-help-ui-open (/ root dcl-file dcl-path dcl-id)
  (setq root
    (if (= (type ae-settings-root) 'SUBR)
      (ae-settings-root)
      nil))
  ;; Try the support path first, then the project root and a relative path.
  (setq dcl-file (findfile "help.dcl"))
  (if (null dcl-file)
    (setq dcl-file (findfile "Extraction\\help.dcl")))
  (if (and (null dcl-file) root)
    (progn
      (setq dcl-path (strcat root "\\Extraction\\help.dcl"))
      (if (findfile dcl-path) (setq dcl-file dcl-path))
    )
  )
  (if (null dcl-file)
    (progn
      (alert "Не найден Extraction\\help.dcl.")
      nil)
    (progn
      (setq dcl-id (load_dialog dcl-file))
      (if (< dcl-id 0)
        (progn
          (alert "Не удалось загрузить окно справки.")
          nil)
        (if (new_dialog "extraction_help_dialog" dcl-id)
          (progn
            (start_list "help_lines")
            (foreach line *AE-HELP-LINES* (add_list line))
            (end_list)
            (action_tile "btn_help_close" "(done_dialog 0)")
            (start_dialog)
            (unload_dialog dcl-id)
            T)
          (progn
            (unload_dialog dcl-id)
            (alert "Не удалось открыть окно справки.")
            nil)))))
)

(princ "\nHELP.LSP загружен.")
(princ)
