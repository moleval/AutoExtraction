// ============================================================
// cutline_filter.dcl — Параметры раскроя хлыстов CUTLINE
//
// РЕДАКЦИЯ 3 (Этап M2):
//   - секции типов разнесены ВЕРТИКАЛЬНО:
//     сверху "Тип мультилинии", ниже "Тип блока";
//   - ширина списков увеличена до 70 символов для длинных имён
// ============================================================

cutline_filter_dialog : dialog {
  label = "Раскрой хлыстов";

  // ----------------------------------------------------------
  // ТИПЫ ДЛЯ РАСКРОЯ (с количеством справа, выровненным)
  // ----------------------------------------------------------
  : boxed_column {
    label = "Какие детали раскроить";

    : row {
      : radio_button {
        key = "rb_line";
        label = "Только линии";
        width = 24;
      }
      : text {
        key = "txt_line_count";
        label = "";
        alignment = right;
        width = 12;
      }
    }

    : row {
      : radio_button {
        key = "rb_mline";
        label = "Только мультилинии";
        width = 24;
      }
      : text {
        key = "txt_mline_count";
        label = "";
        alignment = right;
        width = 12;
      }
    }

    : row {
      : radio_button {
        key = "rb_dynblock";
        label = "Динамические блоки";
        width = 24;
      }
      : text {
        key = "txt_dynblock_count";
        label = "";
        alignment = right;
        width = 12;
      }
    }

    : row {
      : radio_button {
        key = "rb_both";
        label = "Все типы";
        width = 24;
      }
      : text {
        key = "txt_both_count";
        label = "";
        alignment = right;
        width = 12;
      }
    }
  }

  // ----------------------------------------------------------
  // ТИП МУЛЬТИЛИНИИ (имя MLINESTYLE) — ВЕРХНЯЯ секция
  // Активен только при "Только мультилинии"
  // ----------------------------------------------------------
  : boxed_column {
    label = "Тип мультилинии";

    : list_box {
      key = "popup_mline_type";
      width = 70;
      height = 4;
    }
  }

  // ----------------------------------------------------------
  // ТИП БЛОКА (Видимость / EffectiveName) — НИЖНЯЯ секция
  // Активен только при "Динамические блоки"
  // ----------------------------------------------------------
  : boxed_column {
    label = "Тип блока";

    : list_box {
      key = "popup_dynblock_type";
      width = 70;
      height = 4;
    }
  }

  // ----------------------------------------------------------
  // СЛОИ
  // ----------------------------------------------------------
  : boxed_column {
    label = "Выбранные слои";
    : list_box {
      key = "lst_layers";
      width = 70;
      height = 4;
    }
  }

  // ----------------------------------------------------------
  // ПАРАМЕТРЫ РАСКРОЯ
  // ----------------------------------------------------------
  : boxed_column {
    label = "Параметры раскроя";

    : edit_box {
      key = "edt_stock";
      label = "Длина хлыста, мм:";
      edit_width = 12;
    }
    : edit_box {
      key = "edt_kerf";
      label = "Ширина реза, мм:";
      edit_width = 12;
    }
  }

  // ----------------------------------------------------------
  // ЭКСПОРТ
  // ----------------------------------------------------------
  : boxed_row {
    label = "Экспорт";
    : toggle { key = "chk_xls";  label = ".xls"; }
    : toggle { key = "chk_acad"; label = "Таблица AutoCAD"; }
  }

  // ----------------------------------------------------------
  // КНОПКИ
  // ----------------------------------------------------------
  : row {
    alignment = centered;
    : button {
      key = "btn_ok";
      label = "Раскроить";
      is_default = true;
    }
    : button {
      key = "btn_cancel";
      label = "Отмена";
      is_cancel = true;
    }
  }
}